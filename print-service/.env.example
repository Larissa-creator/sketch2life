# Print Service Configuration
# Copy this file to .env and adjust values

# Service
SERVICE_HOST=0.0.0.0
SERVICE_PORT=3005
RELOAD=false
LOG_LEVEL=INFO

KI_BACKEND_URL=http://127.0.0.1:8000

# Printer Mode: true = Mock, false = Real Printer
MOCK_PRINTER=true

# ═══════════════════════════════════════════════════════════════
# BAMBU LAB CLOUD (Remote Control via Cloud API)
# ═══════════════════════════════════════════════════════════════

# Cloud Mode (true = Cloud, false = LAN)
BAMBU_USE_CLOUD=false

# Bambu Lab Account Credentials
BAMBU_EMAIL=your-email@example.com
BAMBU_PASSWORD=your-password

# Bambu Lab User ID (find in Maker World → JSON response, format: u_xxxxxxxx...)
BAMBU_UID=

# Printer Serial Number (find in Printer Settings)
BAMBU_PRINTER_SERIAL=01P00A382700094

# MQTT Settings (for Cloud mode)
BAMBU_MQTT_HOST=mqtt.bambulab.com
BAMBU_MQTT_PORT=8883
BAMBU_MQTT_TLS=true

# ═══════════════════════════════════════════════════════════════
# BAMBU LAB LAN (Local Network Mode)
# ═══════════════════════════════════════════════════════════════

# LAN Mode Credentials (if BAMBU_USE_CLOUD=false)
# Echte Bambu-Drucker nutzen im LAN-Modus FTPS (Port 990) für den 3MF-Upload
# und MQTT (Port 8883) für Status/Befehle - KEINE REST-API.
BAMBU_LOCAL_IP=192.168.2.33
BAMBU_ACCESS_CODE=42470160

# AMS verwenden? false = externe Spule. Muss zum geladenen Filament passen,
# sonst lehnt der Drucker den Druckstart ab.
BAMBU_USE_AMS=false
# Aus welchem AMS-Tray gedruckt wird (0-3).
BAMBU_AMS_TRAY=0

# PFLICHT auch im LAN-Modus: Die Seriennummer steckt in den MQTT-Topics
# device/{serial}/request und device/{serial}/report. Ohne sie schlägt der
# LAN-Connect fehl. Setze BAMBU_PRINTER_SERIAL oben im Cloud-Abschnitt.

# Hinweis: BAMBU_LAN_MODE_PIN wird nicht mehr verwendet (Bambu nutzt im LAN
# den Access Code, keinen separaten PIN).

# ═══════════════════════════════════════════════════════════════
# SLICING (OrcaSlicer headless CLI)
# ═══════════════════════════════════════════════════════════════
# Wandelt die generierte Mesh-3MF in eine druckbare 3MF mit Gcode um.
# Pflicht für echten Druck - ohne Slicing druckt der Drucker nichts.
SLICER_ENABLED=false
SLICER_PATH=C:\Program Files\OrcaSlicer\orca-slicer.exe

# Volle Pfade zu den Profil-JSONs (aus OrcaSlicer resources/profiles/BBL).
# Für P1S: Process-Profil ist das X1C-Profil (geteilt mit P1S).
SLICER_MACHINE_PROFILE=
SLICER_PROCESS_PROFILE=
SLICER_FILAMENT_PROFILE=

SLICER_TIMEOUT_SECONDS=300

