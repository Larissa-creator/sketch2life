# Copy to frontend/.env
# Workshop: .\start-dev.ps1 sets LAN URLs automatically.
# See README.md in the project root.

VITE_API_URL=
VITE_KI_PUBLIC_URL=
VITE_PUBLIC_ORIGIN=

# Optional: direct print API proxy (normally print goes through the 3D backend)
VITE_PRINT_API_URL=

VITE_GENERATE_ROUTE=/convert
VITE_STATUS_ROUTE=/status
VITE_FILE_FIELD=file
VITE_PRINT_ROUTE=/print

VITE_SHOW_WORKSHOP_QR=true
