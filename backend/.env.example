# Meshy API — https://www.meshy.ai/
API_KEY=your_meshy_key_here

# Print service (print-service/, port 3005) — use 127.0.0.1 for client calls on the same PC
PRINT_API_URL=http://127.0.0.1:3005

# Faces per generated model (100–300000). Meshy skips remeshing without this,
# which yields ~2 million faces and 70+ MB per model — too heavy for phones.
TARGET_POLYCOUNT=50000

# Admin password for /admin (workshop management). Required for admin login.
ADMIN_PASSWORD=

# Secret for signing login tokens. If unset, one is generated and stored in
# STORAGE_DIR/.secret — set it explicitly in deployments so tokens survive
# volume resets.
SECRET_KEY=

# Comma-separated allowed frontend origins, e.g. https://sketch2life.vercel.app
# Default * (dev only).
CORS_ORIGINS=

# Regex for origins that cannot be listed, e.g. Vercel preview deployments:
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app
CORS_ORIGIN_REGEX=

# Where models/sketches/db are stored. Point at the persistent volume mount
# in deployments. Default: backend/storage
STORAGE_DIR=
